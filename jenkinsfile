pipeline {
    agent any 
    stages {
        stage ('checkout git'){
            steps{
            
checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[credentialsId: 'kiranjenkins', url: 'https://github.com/Satya-satya989/frontend_dep_docker_lakshman.git']])



            }
        }
        stage ('validate'){
            steps{
                sh ' mvn validate'
            }
        }
        stage ('complie'){
            steps{
                sh ' mvn compile'
            }
        }
        stage ('test'){
            steps{
                sh 'mvn test'
            }
        }
        stage ('package'){
            steps{
                sh 'mvn package'
            }
        }
    }
}
